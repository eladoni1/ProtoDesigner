<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Compiles the generated C# in-process. This is to the C# target what tests/cpp-conformance is to
         the C++ one: proof the emitted source is real code, not just the string we expected. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ProtoDesigner.Core\ProtoDesigner.Core.csproj" />
    <ProjectReference Include="..\..\src\ProtoDesigner.CodeGen\ProtoDesigner.CodeGen.csproj" />
  </ItemGroup>

  <!-- Golden files are read from the source tree by GoldenFileTests, never from bin/. Copying them
       to the output directory would let a stale copy shadow the real one. -->

  <!-- The protovalidate harness is the opposite case: it is source to be compiled by Go, not a baseline
       to compare against, so it travels to the output directory and is rebuilt from there. PreserveNewest
       means an edit to harness.go reaches the next test run. -->
  <ItemGroup>
    <None Update="Protovalidate\harness.go" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Protovalidate\go.mod" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Protovalidate\go.sum" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="ProtoDesigner.Core.Model" />
    <Using Include="ProtoDesigner.Core.Ir" />
    <Using Include="ProtoDesigner.Core.Layout" />
    <Using Include="ProtoDesigner.CodeGen" />
  </ItemGroup>

</Project>
