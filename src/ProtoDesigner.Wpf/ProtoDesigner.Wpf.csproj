<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ProtoDesigner</AssemblyName>
    <RootNamespace>ProtoDesigner.Wpf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoDesigner.Core\ProtoDesigner.Core.csproj" />
    <ProjectReference Include="..\ProtoDesigner.Application\ProtoDesigner.Application.csproj" />
    <ProjectReference Include="..\ProtoDesigner.Persistence.Json\ProtoDesigner.Persistence.Json.csproj" />
    <ProjectReference Include="..\ProtoDesigner.CodeGen\ProtoDesigner.CodeGen.csproj" />
  </ItemGroup>

</Project>
