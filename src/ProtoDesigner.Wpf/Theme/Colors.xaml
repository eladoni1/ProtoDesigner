<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Ink & surfaces (dark base with layered greys) -->
  <Color x:Key="InkColor">#F1F3F8</Color>
  <Color x:Key="InkMutedColor">#B7BECC</Color>
  <Color x:Key="InkDimColor">#8189A2</Color>
  <Color x:Key="InkFadedColor">#5A6478</Color>

  <Color x:Key="Surface0Color">#0F1218</Color>
  <Color x:Key="Surface1Color">#161A22</Color>
  <Color x:Key="Surface2Color">#1D222C</Color>
  <Color x:Key="Surface3Color">#252B37</Color>
  <Color x:Key="Surface4Color">#2F3542</Color>
  <Color x:Key="SurfaceStrokeColor">#2C3141</Color>
  <Color x:Key="SurfaceStrokeStrongColor">#3C4356</Color>

  <!-- Accents. Indigo is primary, teal secondary. -->
  <Color x:Key="AccentColor">#7C5CFF</Color>
  <Color x:Key="AccentHoverColor">#8F72FF</Color>
  <Color x:Key="AccentPressColor">#664BE8</Color>
  <Color x:Key="AccentSoftColor">#2A2450</Color>

  <Color x:Key="TealColor">#26D1B5</Color>
  <Color x:Key="AmberColor">#F5C36A</Color>
  <Color x:Key="RoseColor">#FF6B7A</Color>
  <Color x:Key="LimeColor">#8FE388</Color>
  <Color x:Key="SkyColor">#5CB8FF</Color>

  <Color x:Key="ErrorColor">#FF5A6E</Color>
  <Color x:Key="WarningColor">#F5B94A</Color>
  <Color x:Key="InfoColor">#5CB8FF</Color>
  <Color x:Key="SuccessColor">#4CD07D</Color>

  <!-- Semantic brushes -->
  <SolidColorBrush x:Key="Ink"          Color="{StaticResource InkColor}"/>
  <SolidColorBrush x:Key="InkMuted"     Color="{StaticResource InkMutedColor}"/>
  <SolidColorBrush x:Key="InkDim"       Color="{StaticResource InkDimColor}"/>
  <SolidColorBrush x:Key="InkFaded"     Color="{StaticResource InkFadedColor}"/>

  <SolidColorBrush x:Key="Surface0"     Color="{StaticResource Surface0Color}"/>
  <SolidColorBrush x:Key="Surface1"     Color="{StaticResource Surface1Color}"/>
  <SolidColorBrush x:Key="Surface2"     Color="{StaticResource Surface2Color}"/>
  <SolidColorBrush x:Key="Surface3"     Color="{StaticResource Surface3Color}"/>
  <SolidColorBrush x:Key="Surface4"     Color="{StaticResource Surface4Color}"/>
  <SolidColorBrush x:Key="SurfaceStroke"       Color="{StaticResource SurfaceStrokeColor}"/>
  <SolidColorBrush x:Key="SurfaceStrokeStrong" Color="{StaticResource SurfaceStrokeStrongColor}"/>

  <SolidColorBrush x:Key="Accent"       Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentHover"  Color="{StaticResource AccentHoverColor}"/>
  <SolidColorBrush x:Key="AccentPress"  Color="{StaticResource AccentPressColor}"/>
  <SolidColorBrush x:Key="AccentSoft"   Color="{StaticResource AccentSoftColor}"/>

  <SolidColorBrush x:Key="Teal"         Color="{StaticResource TealColor}"/>
  <SolidColorBrush x:Key="Amber"        Color="{StaticResource AmberColor}"/>
  <SolidColorBrush x:Key="Rose"         Color="{StaticResource RoseColor}"/>
  <SolidColorBrush x:Key="Lime"         Color="{StaticResource LimeColor}"/>
  <SolidColorBrush x:Key="Sky"          Color="{StaticResource SkyColor}"/>

  <SolidColorBrush x:Key="ErrorBrush"   Color="{StaticResource ErrorColor}"/>
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
  <SolidColorBrush x:Key="InfoBrush"    Color="{StaticResource InfoColor}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>

  <!-- Layout node fills (used by the live layout visualiser) -->
  <SolidColorBrush x:Key="NodeParameterFill" Color="#3B5CFF"/>
  <SolidColorBrush x:Key="NodeEnumFill"      Color="#7C5CFF"/>
  <SolidColorBrush x:Key="NodeStructFill"    Color="#26D1B5"/>
  <SolidColorBrush x:Key="NodeArrayFill"     Color="#F5C36A"/>
  <SolidColorBrush x:Key="NodePaddingFill"   Color="#3C4356"/>
  <SolidColorBrush x:Key="NodeVariableFill"  Color="#FF6B7A"/>

  <SolidColorBrush x:Key="NodeStroke" Color="#0F1218"/>
</ResourceDictionary>
