<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

  <sys:Double x:Key="TextXs"      xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>
  <sys:Double x:Key="TextSm"      xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
  <sys:Double x:Key="TextBase"    xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
  <sys:Double x:Key="TextLg"      xmlns:sys="clr-namespace:System;assembly=mscorlib">15</sys:Double>
  <sys:Double x:Key="TextXl"      xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
  <sys:Double x:Key="Text2xl"     xmlns:sys="clr-namespace:System;assembly=mscorlib">22</sys:Double>

  <Style x:Key="H1Text" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="{StaticResource Text2xl}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  </Style>

  <Style x:Key="H2Text" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="{StaticResource TextXl}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  </Style>

  <Style x:Key="H3Text" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="{StaticResource TextLg}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  </Style>

  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="{StaticResource TextBase}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  </Style>

  <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
  </Style>

  <Style x:Key="CaptionText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="{StaticResource TextSm}"/>
    <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style x:Key="MonoText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="{StaticResource TextSm}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  </Style>

  <Style x:Key="SectionLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="{StaticResource TextXs}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource InkDim}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
  </Style>
</ResourceDictionary>
