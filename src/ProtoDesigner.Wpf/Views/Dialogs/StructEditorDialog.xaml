<Window x:Class="ProtoDesigner.Wpf.Views.Dialogs.StructEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:ProtoDesigner.Wpf.Behaviors"
        Title="Struct type"
        Width="560" Height="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Window.Resources>
    <!-- Shared column widths so the header and the rows line up exactly. -->
    <GridLength x:Key="ColDrag">22</GridLength>
    <GridLength x:Key="ColType">130</GridLength>
    <GridLength x:Key="ColSize">80</GridLength>
    <GridLength x:Key="ColRemove">30</GridLength>
  </Window.Resources>

  <Border Background="{StaticResource Surface1}" Padding="20">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock Style="{StaticResource H3Text}" x:Name="HeadingText" Text="Struct type"/>
        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,16"
                   Text="A group of fields laid out in order. Its wire size is the sum of its fields, so there is nothing to set here — drag to change the order."/>

        <TextBlock Style="{StaticResource SectionLabel}" Text="Name"/>
        <TextBox x:Name="NameBox" Padding="10,7" Margin="0,4,0,14"/>
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Style="{StaticResource SectionLabel}" Text="Fields"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <ComboBox x:Name="AddTypeBox" MinWidth="180" Margin="0,0,6,0"/>
          <Button Content="+ Add field" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="11"
                  Click="OnAddField"/>
        </StackPanel>
      </Grid>

      <!-- Column headers — the row template below repeats these widths. -->
      <Border Grid.Row="2" Padding="15,0,15,5">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource ColDrag}"/>
            <ColumnDefinition Width="{StaticResource ColType}"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="{StaticResource ColSize}"/>
            <ColumnDefinition Width="{StaticResource ColRemove}"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="1" Style="{StaticResource SectionLabel}" Text="Type"
                     ToolTip="The type this field is an instance of. Set when the field is added."/>
          <TextBlock Grid.Column="2" Style="{StaticResource SectionLabel}" Text="Field name"
                     ToolTip="What this occurrence is called, in generated code and on this dialog only."/>
          <TextBlock Grid.Column="3" Style="{StaticResource SectionLabel}" Text="On wire"
                     ToolTip="Serialised size of one field, from its type. Change it by editing that type."/>
        </Grid>
      </Border>

      <Border Grid.Row="3" Background="{StaticResource Surface0}" CornerRadius="6"
              BorderBrush="{StaticResource SurfaceStroke}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
          <ItemsControl x:Name="FieldsList"
                        b:DragReorder.IsEnabled="True"
                        b:DragReorder.ReorderRequested="OnReorderRequested">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="8,6" Margin="0,2" CornerRadius="6" Background="{StaticResource Surface2}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{StaticResource ColDrag}"/>
                      <ColumnDefinition Width="{StaticResource ColType}"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="{StaticResource ColSize}"/>
                      <ColumnDefinition Width="{StaticResource ColRemove}"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⠿" Foreground="{StaticResource InkFaded}"
                               VerticalAlignment="Center" TextAlignment="Center" Cursor="SizeNS"
                               ToolTip="Drag to reorder"/>
                    <TextBlock Grid.Column="1" Text="{Binding TypeName}" Margin="0,0,8,0"
                               FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"
                               Foreground="{StaticResource Teal}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBox Grid.Column="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource MonoFont}" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="3" Text="{Binding SizeLabel}" Style="{StaticResource CaptionText}"
                               FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="✕" Width="26" Height="26"
                            ToolTip="Remove field" Click="OnRemoveField" Tag="{Binding}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <Border Grid.Row="4" x:Name="ErrorBanner" Background="{StaticResource Surface3}" CornerRadius="6"
              Padding="10,7" Margin="0,12,0,0" Visibility="Collapsed">
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
      </Border>

      <Grid Grid.Row="5" Margin="0,16,0,0">
        <TextBlock x:Name="TotalText" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="OnCancel" MinWidth="88"/>
          <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSave" MinWidth="88" Margin="8,0,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
