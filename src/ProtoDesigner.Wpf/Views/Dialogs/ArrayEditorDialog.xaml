<Window x:Class="ProtoDesigner.Wpf.Views.Dialogs.ArrayEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Array type"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Border Background="{StaticResource Surface1}" Padding="20">
    <StackPanel>
      <TextBlock Style="{StaticResource H3Text}" x:Name="HeadingText" Text="Array type"/>
      <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,16"
                 Text="A repeated element. Its wire size comes from the element type multiplied by the count, so there is nothing to set here."/>

      <TextBlock Style="{StaticResource SectionLabel}" Text="Name"/>
      <TextBox x:Name="NameBox" Padding="10,7" Margin="0,4,0,14"/>

      <TextBlock Style="{StaticResource SectionLabel}" Text="Element type"/>
      <ComboBox x:Name="ElementBox" Margin="0,4,0,4" SelectionChanged="OnElementChanged"/>
      <TextBlock x:Name="ElementHint" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,14"/>

      <TextBlock Style="{StaticResource SectionLabel}" Text="Length"
                 ToolTip="A fixed array is always the same size on the wire. A variable one carries its own count, so the message length changes with it."/>
      <ComboBox x:Name="LengthBox" Margin="0,4,0,10" SelectionChanged="OnLengthKindChanged"/>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" x:Name="MinPanel">
          <TextBlock Style="{StaticResource SectionLabel}" Text="Minimum elements"
                     ToolTip="The fewest a valid message may carry. 0 means an empty array is allowed. This is a declared limit, not a wire mechanism — it reaches the protobuf schema as min_items and raises the message's reported minimum size."/>
          <TextBox x:Name="MinBox" Padding="10,7" Margin="0,4,0,0"
                   FontFamily="{StaticResource MonoFont}" TextChanged="OnCountChanged"/>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock x:Name="CountLabel" Style="{StaticResource SectionLabel}" Text="Number of elements"/>
          <TextBox x:Name="CountBox" Padding="10,7" Margin="0,4,0,0"
                   FontFamily="{StaticResource MonoFont}" TextChanged="OnCountChanged"/>
        </StackPanel>
      </Grid>

      <!-- How a variable array's length reaches the wire. Hidden for a fixed array, which has no length
           to carry. -->
      <StackPanel x:Name="SourcePanel" Margin="0,14,0,0">
        <TextBlock Style="{StaticResource SectionLabel}" Text="Where the element count comes from"
                   ToolTip="Either another field in the same message holds the count, or the array writes its own count immediately before its elements."/>
        <ComboBox x:Name="SourceBox" Margin="0,4,0,0" SelectionChanged="OnLengthSourceChanged"/>

        <StackPanel x:Name="CountFieldPanel" Margin="0,10,0,0">
          <TextBlock Style="{StaticResource SectionLabel}" Text="Count field"/>
          <ComboBox x:Name="CountFieldBox" Margin="0,4,0,0" SelectionChanged="OnCountFieldChanged"/>
          <TextBlock x:Name="CountFieldHint" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                     Margin="0,4,0,0"/>
          <TextBlock x:Name="SharedWarning" Foreground="{StaticResource ErrorBrush}" FontSize="11"
                     TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </StackPanel>

      <TextBlock x:Name="SizeHint" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0"/>

      <Border x:Name="ErrorBanner" Background="{StaticResource Surface3}" CornerRadius="6"
              Padding="10,7" Margin="0,14,0,0" Visibility="Collapsed">
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="OnCancel" MinWidth="88"/>
        <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSave" MinWidth="88" Margin="8,0,0,0"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
