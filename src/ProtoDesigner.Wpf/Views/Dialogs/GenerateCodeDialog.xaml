<Window x:Class="ProtoDesigner.Wpf.Views.Dialogs.GenerateCodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate code"
        Width="1120" Height="780"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Border Background="{StaticResource Surface1}" Padding="20">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <!-- Options the selected target declares. Auto-sized, so a target with none costs no space. -->
        <RowDefinition Height="Auto"/>
        <!-- protoc languages, for the schema target only. Same deal: no target, no space. -->
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock Style="{StaticResource H3Text}" Text="Generate code"/>
        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,16"
                   Text="Preview the output here, then write it to a folder. Generation is refused while the project has any error — a broken protocol should fail with a diagnostic, not at the compiler."/>
      </StackPanel>

      <!-- Options -->
      <Grid Grid.Row="1" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Style="{StaticResource SectionLabel}" Text="Language"
                     ToolTip="Which generator produces the output."/>
          <ComboBox x:Name="TargetBox" Margin="0,4,0,0" SelectionChanged="OnOptionChanged"/>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Style="{StaticResource SectionLabel}" Text="What to generate"
                     ToolTip="A module covers every message it sends or receives, on every bus it sits on — both directions, so loopback works."/>
          <ComboBox x:Name="ScopeBox" Margin="0,4,0,0" SelectionChanged="OnOptionChanged"/>
        </StackPanel>

        <StackPanel Grid.Column="4">
          <TextBlock Style="{StaticResource SectionLabel}" Text="Namespace"
                     ToolTip="Wraps the generated declarations, and names the shared types file."/>
          <TextBox x:Name="NamespaceBox" Margin="0,4,0,0" Padding="8,6"
                   FontFamily="{StaticResource MonoFont}" TextChanged="OnOptionChanged"/>
        </StackPanel>
      </Grid>

      <!-- Assigning protobuf field numbers is an edit, not a side effect of generating, so it is an
           explicit action that lands in the undo history. -->
      <Button Grid.Row="2" x:Name="AssignNumbersButton" Style="{StaticResource GhostButton}"
              HorizontalAlignment="Left" Margin="0,0,0,10" Padding="10,5" FontSize="12"
              Visibility="Collapsed" Click="OnAssignFieldNumbers"
              Content="Assign protobuf field numbers"
              ToolTip="Fields with no number fall back to their position, which moves if a field moves. Assigning pins them so a regenerated schema stays compatible with deployed peers. Undoable."/>

      <!-- Target-specific options, declared by whichever generator is selected. -->
      <ItemsControl Grid.Row="2" x:Name="TargetOptionsList" Margin="0,0,0,12" Visibility="Collapsed"
                    HorizontalAlignment="Right">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled}"
                      ToolTip="{Binding Description}" Margin="0,6,16,0"
                      Checked="OnTargetOptionToggled" Unchecked="OnTargetOptionToggled"
                      Tag="{Binding}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <!-- Compiling the emitted schema. Only for the schema target, and only when protoc is installed:
           this is a second step over the written files, not a generator setting. -->
      <StackPanel Grid.Row="3" x:Name="ProtocPanel" Visibility="Collapsed" Margin="0,0,0,12">
        <TextBlock Style="{StaticResource SectionLabel}" Text="Also compile the schema with protoc"
                   ToolTip="Runs the real protobuf compiler over the .proto files after they are written, so you get usable source rather than a schema you still have to build."/>
        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0"
                   Text="protobuf has no C backend. For C, use the 'c' target — it is freestanding, allocation-free, and speaks this tool's own wire format rather than protobuf's."/>
        <ItemsControl x:Name="ProtocList" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled}"
                        ToolTip="{Binding Description}" Margin="0,4,16,0"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>

      <TextBlock Grid.Row="3" x:Name="ProtocMissingText" Visibility="Collapsed"
                 Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,12"
                 Text="protoc was not found, so the schema can only be written, not compiled. Put it in protobuf/bin/ next to the solution, set PROTODESIGNER_PROTOC, or add it to PATH — it is not bundled, because it is a large platform-specific binary."/>

      <!-- Refusal / status banner -->
      <Border Grid.Row="4" x:Name="StatusBanner" Background="{StaticResource Surface3}" CornerRadius="6"
              Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontWeight="SemiBold"/>
          <ItemsControl x:Name="StatusList" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}"
                           FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,1"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- File list + preview -->
      <Grid Grid.Row="5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260" MinWidth="180"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Surface0}" CornerRadius="6"
                BorderBrush="{StaticResource SurfaceStroke}" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="12,8" BorderBrush="{StaticResource SurfaceStroke}" BorderThickness="0,0,0,1">
              <TextBlock Style="{StaticResource SectionLabel}" Text="Files"/>
            </Border>
            <ListBox Grid.Row="1" x:Name="FileList" Background="Transparent" BorderThickness="0"
                     Padding="4" SelectionChanged="OnFileSelected"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="4,3">
                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent"/>

        <Border Grid.Column="2" Background="{StaticResource Surface0}" CornerRadius="6"
                BorderBrush="{StaticResource SurfaceStroke}" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="12,8" BorderBrush="{StaticResource SurfaceStroke}" BorderThickness="0,0,0,1">
              <Grid>
                <TextBlock x:Name="PreviewTitle" Style="{StaticResource SectionLabel}" Text="Preview"/>
                <Button Content="Copy" Style="{StaticResource GhostButton}" Padding="10,3" FontSize="11"
                        HorizontalAlignment="Right" Click="OnCopy"
                        ToolTip="Copy the previewed file to the clipboard"/>
              </Grid>
            </Border>
            <!-- Read-only rather than a TextBlock so the output can be selected and copied out. -->
            <TextBox Grid.Row="1" x:Name="PreviewText" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     Background="Transparent" BorderThickness="0" Padding="12,8"
                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                     TextWrapping="NoWrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
          </Grid>
        </Border>
      </Grid>

      <!-- Output folder + actions -->
      <Grid Grid.Row="6" Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="Output folder" Style="{StaticResource SectionLabel}"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox Grid.Column="1" x:Name="OutputBox" Padding="8,6" VerticalAlignment="Center"
                 FontFamily="{StaticResource MonoFont}"/>
        <Button Grid.Column="2" Content="Browse…" Style="{StaticResource GhostButton}"
                Margin="8,0,0,0" Click="OnBrowse"/>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0">
          <Button Content="Close" Style="{StaticResource GhostButton}" Click="OnCancel" MinWidth="88"/>
          <Button x:Name="WriteButton" Content="Write files" Style="{StaticResource PrimaryButton}"
                  Click="OnWrite" MinWidth="110" Margin="8,0,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
