<Window x:Class="ProtoDesigner.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProtoDesigner.Wpf.ViewModels"
        xmlns:v="clr-namespace:ProtoDesigner.Wpf.Views"
        Title="{Binding WindowTitle}"
        Width="1440" Height="900"
        MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen">
  <Window.DataContext>
    <vm:MainViewModel/>
  </Window.DataContext>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Title / menu row -->
    <Border Grid.Row="0" Background="{StaticResource Surface1}"
            BorderBrush="{StaticResource SurfaceStroke}" BorderThickness="0,0,0,1"
            Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Accent}" VerticalAlignment="Center">
            <TextBlock Text="P" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
          </Border>
          <TextBlock Text="ProtoDesigner" Style="{StaticResource H3Text}" Margin="10,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="·" Foreground="{StaticResource InkDim}" Margin="10,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Project.Name}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
        </StackPanel>

        <Menu Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
          <MenuItem Header="_File">
            <MenuItem Header="_New project" Command="{Binding NewCommand}" InputGestureText="Ctrl+N"/>
            <MenuItem Header="_Open…" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
            <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
            <MenuItem Header="Save _As…" Command="{Binding SaveAsCommand}"/>
            <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
          </MenuItem>
          <MenuItem Header="_Edit">
            <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
            <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
          </MenuItem>
        </Menu>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource Chip}" Background="{StaticResource AccentSoft}"
                  Visibility="{Binding Project.IsDirty, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Unsaved" FontSize="11" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
          </Border>
          <Button Content="Generate code" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                  Command="{x:Static v:MainWindow.GenerateCodeCommand}"
                  ToolTip="Preview and write C++ or C# for this project (Ctrl+G)"/>
          <Button Content="Save" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                  Command="{Binding SaveCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Command bar -->
    <Border Grid.Row="1" Background="{StaticResource Surface0}"
            BorderBrush="{StaticResource SurfaceStroke}" BorderThickness="0,0,0,1"
            Padding="16,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Design binary protocols. Compose types into messages, control the wire layout down to the bit." Style="{StaticResource CaptionText}"/>
      </StackPanel>
    </Border>

    <!-- Main working area: 3 columns -->
    <Grid Grid.Row="2" Margin="12,10,12,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" MinWidth="240"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*" MinWidth="700"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="400" MinWidth="300"/>
      </Grid.ColumnDefinitions>

      <!-- Left: Buses + Messages + Types (tabbed) -->
      <Border Grid.Column="0" Style="{StaticResource Card}">
        <v:ProjectTreeView DataContext="{Binding Project}"/>
      </Border>

      <GridSplitter Grid.Column="1"/>

      <!-- Middle: Message editor -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <v:MessageEditorView DataContext="{Binding Project}"/>
      </Border>

      <GridSplitter Grid.Column="3"/>

      <!-- Right: Layout visualization + Diagnostics -->
      <Grid Grid.Column="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="240" MinHeight="120"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
          <v:LayoutListView DataContext="{Binding Project.LayoutList}"/>
        </Border>

        <Border Grid.Row="1" Height="8"/>

        <Border Grid.Row="2" Style="{StaticResource Card}">
          <v:DiagnosticsView DataContext="{Binding Project.Diagnostics}"/>
        </Border>
      </Grid>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="3" Background="{StaticResource Surface1}"
            BorderBrush="{StaticResource SurfaceStroke}" BorderThickness="0,1,0,0"
            Padding="16,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <TextBlock Style="{StaticResource CaptionText}" Text="Buses: "/>
          <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Project.Buses.Count}"/>
          <TextBlock Style="{StaticResource CaptionText}" Text="  ·  Types: " Margin="6,0,0,0"/>
          <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Project.TypeCount}"/>
        </StackPanel>
        <TextBlock Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource CaptionText}"
                   Text="{Binding Project.Diagnostics.Summary}"/>
        <TextBlock Grid.Column="2" Style="{StaticResource CaptionText}"
                   Text="v0.5 — model · validation · storage · C++ codegen"/>
      </Grid>
    </Border>
  </Grid>

  <Window.CommandBindings>
    <CommandBinding Command="{x:Static v:MainWindow.GenerateCodeCommand}" Executed="OnGenerateCode"/>
  </Window.CommandBindings>

  <Window.InputBindings>
    <KeyBinding Key="G" Modifiers="Ctrl" Command="{x:Static v:MainWindow.GenerateCodeCommand}"/>
    <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
    <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}"/>
    <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
    <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewCommand}"/>
    <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}"/>
  </Window.InputBindings>
</Window>
