<UserControl x:Class="ProtoDesigner.Wpf.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource SectionHeaderBar}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="Diagnostics"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Border Style="{StaticResource Chip}" Background="{StaticResource Surface3}" Margin="0,0,6,0">
            <StackPanel Orientation="Horizontal">
              <Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
              <TextBlock Text="{Binding ErrorCount}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" FontSize="11"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Chip}" Background="{StaticResource Surface3}" Margin="0,0,6,0">
            <StackPanel Orientation="Horizontal">
              <Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
              <TextBlock Text="{Binding WarningCount}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" FontSize="11"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Chip}" Background="{StaticResource Surface3}">
            <StackPanel Orientation="Horizontal">
              <Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource InfoBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
              <TextBlock Text="{Binding InfoCount}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" FontSize="11"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                  Visibility="{Binding HasNone, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="✓" HorizontalAlignment="Center" FontSize="28" Foreground="{StaticResource SuccessBrush}"/>
        <TextBlock Text="No issues" Style="{StaticResource H3Text}" HorizontalAlignment="Center" Margin="0,8,0,2"/>
        <TextBlock Text="The model is valid and ready for codegen." Style="{StaticResource CaptionText}"/>
      </StackPanel>

      <ScrollViewer Padding="12,8" VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding HasNone, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
        <ItemsControl ItemsSource="{Binding Diagnostics}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="10,7" Margin="0,2" CornerRadius="6" Background="{StaticResource Surface2}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Severity, Converter={StaticResource SeverityToGlyph}}"
                             Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                             FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Target}" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
                  </StackPanel>
                  <Border Grid.Column="2" Background="{StaticResource Surface3}" CornerRadius="4" Padding="6,2" VerticalAlignment="Top" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Code}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource InkMuted}"/>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
