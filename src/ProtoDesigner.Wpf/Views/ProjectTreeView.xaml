<UserControl x:Class="ProtoDesigner.Wpf.Views.ProjectTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProtoDesigner.Wpf.ViewModels">
  <UserControl.Resources>

    <!-- Four sub-tabs have to share a narrow panel; without tighter padding TabPanel wraps them onto
         two rows and reorders them, which reads as a glitch. -->
    <Style x:Key="CompactTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
      <Setter Property="Padding" Value="7,8"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- One row in a Types sub-tab. Click selects (Add field uses it); double-click opens the editor. -->
    <DataTemplate x:Key="TypeRow" DataType="{x:Type vm:TypeItemViewModel}">
      <Border Padding="8,6" Margin="0,2" CornerRadius="6" Background="{StaticResource Surface2}"
              MouseLeftButtonUp="OnTypeClicked" MouseRightButtonUp="OnTypeClicked"
              Cursor="Hand" Tag="{Binding}">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Edit..."    Click="OnEditType" FontWeight="SemiBold"/>
            <MenuItem Header="Rename..."  Click="OnRenameType"/>
            <MenuItem Header="Duplicate"  Click="OnDuplicateType"/>
            <Separator/>
            <MenuItem Header="Delete"     Click="OnDeleteType"/>
          </ContextMenu>
        </Border.ContextMenu>
        <StackPanel>
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding DetailLabel}" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
        </StackPanel>
      </Border>
    </DataTemplate>

  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <!-- The selected-type banner gets a row of its own. It used to sit bottom-aligned inside the tab
           row, which meant it floated over the list and hid the last entry once the list was long
           enough to reach it. -->
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource SectionHeaderBar}">
      <TextBlock Text="Structure" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
    </Border>

    <TabControl Grid.Row="1">

      <!-- ===================== BUSES ===================== -->
      <TabItem Header="Buses">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,8,8,4">
            <Button Content="+ Create bus" Style="{StaticResource PrimaryButton}"
                    Padding="10,5" FontSize="12" Click="OnCreateBus"/>
            <Button Content="+ Create message" Style="{StaticResource GhostButton}"
                    Padding="10,5" FontSize="12" Margin="6,0,0,0" Click="OnCreateMessage"
                    ToolTip="Adds a message to the selected bus"/>
          </StackPanel>

          <ScrollViewer Grid.Row="1" Padding="8,0,8,8" VerticalScrollBarVisibility="Auto">
            <TreeView x:Name="Tree" ItemsSource="{Binding Buses}"
                      SelectedItemChanged="OnSelectedItemChanged">
              <TreeView.Resources>

                <HierarchicalDataTemplate DataType="{x:Type vm:BusViewModel}" ItemsSource="{Binding Messages}">
                  <StackPanel Orientation="Horizontal" Tag="{Binding}">
                    <StackPanel.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Edit bus and modules..." Click="OnEditBus" FontWeight="SemiBold"/>
                        <MenuItem Header="Add message" Click="OnCreateMessage"/>
                        <MenuItem Header="Rename..."   Click="OnRenameBus"/>
                        <Separator/>
                        <MenuItem Header="Delete bus"  Click="OnDeleteBus"/>
                      </ContextMenu>
                    </StackPanel.ContextMenu>
                    <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource Teal}"
                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SubtitleLabel}" Style="{StaticResource CaptionText}"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </HierarchicalDataTemplate>

                <DataTemplate DataType="{x:Type vm:MessageViewModel}">
                  <StackPanel Orientation="Horizontal" Tag="{Binding}">
                    <StackPanel.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Rename..."      Click="OnRenameMessage"/>
                        <Separator/>
                        <MenuItem Header="Delete message" Click="OnDeleteMessage"/>
                      </ContextMenu>
                    </StackPanel.ContextMenu>
                    <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource Accent}"
                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}"/>
                    <TextBlock Text="{Binding RoutesLabel}" Style="{StaticResource CaptionText}"
                               Foreground="{StaticResource Teal}" Margin="6,0,0,0" VerticalAlignment="Center"
                               MaxWidth="180" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding RoutesLabel}"/>
                    <TextBlock Text="{Binding SizeLabel, StringFormat=' - {0}'}"
                               Style="{StaticResource CaptionText}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>

              </TreeView.Resources>
            </TreeView>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ===================== TYPES ===================== -->
      <TabItem Header="Types">
        <TabControl>

          <TabItem Header="Primitives" Style="{StaticResource CompactTab}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Button Grid.Row="0" Content="+ Create primitive" Style="{StaticResource PrimaryButton}"
                      Padding="10,5" FontSize="12" Margin="8" HorizontalAlignment="Left"
                      Click="OnCreatePrimitive"/>
              <ScrollViewer Grid.Row="1" Padding="8,0,8,8" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Types.Primitives}" ItemTemplate="{StaticResource TypeRow}"/>
              </ScrollViewer>
            </Grid>
          </TabItem>

          <TabItem Header="Enums" Style="{StaticResource CompactTab}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Button Grid.Row="0" Content="+ Create enum" Style="{StaticResource PrimaryButton}"
                      Padding="10,5" FontSize="12" Margin="8" HorizontalAlignment="Left"
                      Click="OnCreateEnum"/>
              <ScrollViewer Grid.Row="1" Padding="8,0,8,8" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Types.Enums}" ItemTemplate="{StaticResource TypeRow}"/>
              </ScrollViewer>
            </Grid>
          </TabItem>

          <TabItem Header="Structs" Style="{StaticResource CompactTab}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Button Grid.Row="0" Content="+ Create struct" Style="{StaticResource PrimaryButton}"
                      Padding="10,5" FontSize="12" Margin="8" HorizontalAlignment="Left"
                      Click="OnCreateStruct"/>
              <ScrollViewer Grid.Row="1" Padding="8,0,8,8" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Types.Structs}" ItemTemplate="{StaticResource TypeRow}"/>
              </ScrollViewer>
            </Grid>
          </TabItem>

          <TabItem Header="Arrays" Style="{StaticResource CompactTab}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Button Grid.Row="0" Content="+ Create array" Style="{StaticResource PrimaryButton}"
                      Padding="10,5" FontSize="12" Margin="8" HorizontalAlignment="Left"
                      Click="OnCreateArray"/>
              <ScrollViewer Grid.Row="1" Padding="8,0,8,8" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Types.Arrays}" ItemTemplate="{StaticResource TypeRow}"/>
              </ScrollViewer>
            </Grid>
          </TabItem>

        </TabControl>
      </TabItem>
    </TabControl>

    <!-- Selected-type banner so it is obvious what "Add field" will insert -->
    <Border Grid.Row="2" Background="{StaticResource AccentSoft}"
            BorderBrush="{StaticResource SurfaceStroke}" BorderThickness="0,1,0,0" Padding="12,7"
            Visibility="{Binding HasSelectedType, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionLabel}" Text="Selected type"/>
        <TextBlock Text="{Binding SelectedType.Name}" Foreground="{StaticResource Accent}"
                   FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
